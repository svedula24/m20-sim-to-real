#!/usr/bin/env bash
# ============================================================================
# m20 — operator CLI for the mission server (usability layer over RunMission).
#
#   tools/dev/m20 goto X Y [YAW]            one goal, via the mission server
#   tools/dev/m20 mission "X,Y[,YAW]" ...   ordered patrol of waypoints (no yaw = face the next waypoint)
#   tools/dev/m20 mission --route r.yaml    the same from a route file (tools/missions/route.py, tools/missions/*.yaml)
#   tools/dev/m20 say "go to the printer"   natural language (NavigateNL); --dry-run --pick ID
#   tools/dev/m20 status                    mode / failsafe / behavior snapshot
#
# Everything runs inside the commander container; goals are map-frame meters.
# The mission server rejects missions unless the commander is armed in
# ASSISTED/AUTONOMOUS (ADR-005) — arm first via bringup or set_mode.
# ============================================================================
set -e
C=docker-commander-1
SRC="source /opt/ros/humble/setup.bash; source /ws/install/setup.bash; export ROS_DOMAIN_ID=42 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
CMD="${1:-help}"; shift || true

case "$CMD" in
  goto)
    [ $# -eq 2 ] || [ $# -eq 3 ] || { echo "usage: m20 goto X Y [YAW]"; exit 1; }
    exec "$0" mission "$(IFS=,; echo "$*")"
    ;;
  mission)
    # Waypoints: "X,Y" or "X,Y,YAW" arguments, or --route file.yaml (tools/missions/route.py format). A waypoint
    # without a yaw FACES THE NEXT ONE (the old CLI sent every goal with yaw 0 = face east, so the robot turned to
    # face +x at every stop). wait_s in a route becomes a TYPE_WAIT item.
    [ $# -ge 1 ] || { echo "usage: m20 mission \"X,Y[,YAW]\" [\"X,Y[,YAW]\" ...] | m20 mission --route file.yaml"; exit 1; }
    REPO="$(cd "$(dirname "$0")/../.." && pwd)"
    docker cp "$REPO/tools/missions/route.py" $C:/cfg/route.py
    if [ "$1" = "--route" ]; then
      [ $# -eq 2 ] && [ -f "$2" ] || { echo "usage: m20 mission --route file.yaml (file must exist)"; exit 1; }
      docker cp "$2" $C:/cfg/route.yaml
      WPS="--route /cfg/route.yaml"
    else
      WPS="$*"
    fi
    docker exec -i $C bash -lc "$SRC; python3 - $WPS <<'PYEOF'
import sys, math, time
sys.path.insert(0, '/cfg')
import route
import rclpy
from rclpy.action import ActionClient
from m20_msgs.action import RunMission
from m20_msgs.msg import MissionItem

args = sys.argv[1:]
try:
    wps = route.load_route(args[1]) if args[0] == '--route' else [route.parse_wp_arg(a, i) for i, a in enumerate(args)]
except ValueError as e:
    print(f'ERROR: {e}'); sys.exit(1)
wps = route.fill_auto_yaw(wps)

rclpy.init()
n = rclpy.create_node('m20_cli')
cli = ActionClient(n, RunMission, '/m20/mission/run')
if not cli.wait_for_server(timeout_sec=5.0):
    print('ERROR: mission server not running'); sys.exit(1)

goal = RunMission.Goal()
for w in wps:
    it = MissionItem(); it.type = MissionItem.TYPE_GOTO; it.label = w.label
    it.goal.header.frame_id = 'map'
    it.goal.pose.position.x = w.x; it.goal.pose.position.y = w.y
    it.goal.pose.orientation.z, it.goal.pose.orientation.w = route.quaternion_z(w.yaw)
    goal.items.append(it)
    print(f'  {w.label}: ({w.x:.2f}, {w.y:.2f}) yaw {math.degrees(w.yaw):.0f} deg', flush=True)
    if w.wait_s > 0:
        wt = MissionItem(); wt.type = MissionItem.TYPE_WAIT; wt.wait_seconds = float(w.wait_s); wt.label = w.label + '_wait'
        goal.items.append(wt)

def fb(msg):
    f = msg.feedback
    eta = f'{f.eta_seconds:.0f}s' if f.eta_seconds >= 0 else '?'
    print(f'  [{f.current_index}] {f.current_label}: {f.status} (eta {eta})', flush=True)

send = cli.send_goal_async(goal, feedback_callback=fb)
rclpy.spin_until_future_complete(n, send)
gh = send.result()
if not gh.accepted:
    print('REJECTED (armed? ASSISTED/AUTONOMOUS?)'); sys.exit(1)
print(f'mission accepted: {len(goal.items)} item(s)')
res = gh.get_result_async()
rclpy.spin_until_future_complete(n, res)
r = res.result().result
print(f'mission result: success={r.success} completed={r.completed}/{len(goal.items)} — {r.detail}')
sys.exit(0 if r.success else 2)
PYEOF"
    ;;
  say)
    DRY=0; PICK=-1; TEXT=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dry-run) DRY=1 ;;
        --pick) PICK="$2"; shift ;;
        *) TEXT="${TEXT:+$TEXT }$1" ;;
      esac
      shift
    done
    [ -n "$TEXT" ] || { echo "usage: m20 say [--dry-run] [--pick ID] \"go to the printer\""; exit 1; }
    docker exec -i -e NL_TEXT="$TEXT" -e NL_DRY=$DRY -e NL_PICK=$PICK $C bash -lc "$SRC; python3 - <<'PYEOF'
import os, sys
import rclpy
from rclpy.action import ActionClient
from m20_msgs.action import NavigateNL

rclpy.init()
n = rclpy.create_node('m20_cli_say')
cli = ActionClient(n, NavigateNL, '/m20/nlnav/navigate')
if not cli.wait_for_server(timeout_sec=5.0):
    print('ERROR: NL navigation not running (bringup with M20_NLNAV=1)'); sys.exit(1)
g = NavigateNL.Goal()
g.text = os.environ['NL_TEXT']
g.dry_run = os.environ['NL_DRY'] == '1'
g.pick_id = int(os.environ['NL_PICK'])

last = {}
def fb(msg):
    f = msg.feedback
    key = (f.stage, f.current_index, f.status)
    if key != last.get('k'):
        last['k'] = key
        print(f'  {f.stage}' + (f' [{f.current_index}] {f.current_label}: {f.status}' if f.current_label else ''), flush=True)

send = cli.send_goal_async(g, feedback_callback=fb)
rclpy.spin_until_future_complete(n, send)
res = send.result().get_result_async()
rclpy.spin_until_future_complete(n, res)
r = res.result().result
print(f'{r.status}: {r.interpretation}' + (f' — {r.detail}' if r.detail else '') + f'  ({r.latency_ms:.0f} ms, tier {r.tier})')
for it in r.items:
    p = it.goal.pose.position
    print(f'  goal {it.label}: ({p.x:.2f}, {p.y:.2f})')
for c in r.candidates[1:6]:
    print(f'  other match {c.object_id}: {c.cls} at ({c.position.x:.1f}, {c.position.y:.1f}) — {c.why}  (--pick {c.object_id})')
sys.exit(0 if r.success else 2)
PYEOF"
    ;;
  status)
    # read with rclpy, not the ros2 CLI: the CLI daemon wedges in the commander container and then reads nothing
    docker exec -i $C bash -lc "$SRC; timeout 15 python3 -" <<'PYEOF'
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy
from m20_msgs.msg import RobotMode, FailsafeStatus, BehaviorStatus
rclpy.init(); n = Node("m20_cli_status"); got = {}
latched = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE, durability=DurabilityPolicy.TRANSIENT_LOCAL)
n.create_subscription(RobotMode, "/m20/mode", lambda m: got.__setitem__("mode", m), latched)
n.create_subscription(FailsafeStatus, "/m20/failsafe", lambda m: got.__setitem__("failsafe", m), 10)   # volatile publisher (commander_node.py): a latched subscriber never matches it
n.create_subscription(BehaviorStatus, "/m20/behavior/status", lambda m: got.__setitem__("behavior", m), 10)
for _ in range(30):
    rclpy.spin_once(n, timeout_sec=0.1)
m = got.get("mode"); f = got.get("failsafe"); b = got.get("behavior")
print("--- mode ---"); print(f"mode: {m.mode}  armed: {m.armed}" if m else "(no mode published)")
print("--- failsafe ---"); print(f"active: {f.active}  severity: {f.severity}" if f else "(none)")
print("--- behavior ---"); print(f"behavior_name: {b.behavior_name}  state: {b.state}" if b else "(none)")
PYEOF
    ;;
  *)
    grep '^#   tools/dev/m20' "$0" | sed 's/^#  //'
    ;;
esac
