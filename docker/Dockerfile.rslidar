# The lidar stage image: rslidar_sdk (RoboSense Airy driver) + pointcloud_to_laserscan + tf2, for the one container
# that turns the two relayed multicast streams into /scan_front and /scan_rear (tools/lidar/lidar_up.sh). Builds the
# same on x86 (CI) and arm64 (armdog); ros:humble-ros-base is multi-arch.
#   docker build -f docker/Dockerfile.rslidar -t m20_lidar:latest .
# Pins: the commits the robot's own workspace builds (rslidar_sdk v1.5.20 era), not a floating branch.
FROM ros:humble-ros-base
SHELL ["/bin/bash", "-lc"]
ARG RSLIDAR_MSG_SHA=fe8a95cb242bd294cc3d5e3422f2093fb49a56ee
ARG RSLIDAR_SDK_SHA=8b4b4b7ff910799260347821084c59e1c73d50d5
RUN apt-get update && apt-get install -y --no-install-recommends \
      git libpcap-dev libyaml-cpp-dev libeigen3-dev python3-colcon-common-extensions \
      ros-humble-pointcloud-to-laserscan ros-humble-rmw-cyclonedds-cpp ros-humble-rmw-fastrtps-cpp \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /ws/src
RUN git clone https://github.com/RoboSense-LiDAR/rslidar_msg.git && cd rslidar_msg && git checkout -q ${RSLIDAR_MSG_SHA} && cd .. \
    && git clone https://github.com/RoboSense-LiDAR/rslidar_sdk.git && cd rslidar_sdk && git checkout -q ${RSLIDAR_SDK_SHA} \
    && git submodule update --init --recursive
WORKDIR /ws
# v1.5.20 picks ROS 2 up from the environment (no COMPILE_METHOD edit). ENABLE_TRANSFORM stays OFF: points stay in the
# sensor frame and TF carries the mount; with it on, the mount would be applied twice. The CMakeCache line proves it.
RUN source /opt/ros/humble/setup.bash && colcon build --symlink-install --cmake-args -DENABLE_TRANSFORM=OFF -DCMAKE_BUILD_TYPE=Release \
    && grep -q 'ENABLE_TRANSFORM:BOOL=OFF' build/rslidar_sdk/CMakeCache.txt
COPY docker/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
